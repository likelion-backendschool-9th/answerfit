# 실행 환경: local, test, production. 없으면 npm run dev는 local, 빌드 결과는 production으로 본다.
# production에서는 모드 전환기를 숨기고 항상 실제 API를 쓴다.
APP_ENV=local
# 개발 모드(실제 API)가 부를 백엔드 주소
BACKEND_URL=http://localhost:8080
# 이 사이트의 주소. 카카오 Redirect URI({SITE_URL}/auth/kakao/callback)를 만든다
SITE_URL=http://localhost:3000
# 카카오 앱 REST API 키(AnswerFit). 카카오 앱 콘솔 > 앱 > 플랫폼 키에서 본다
KAKAO_CLIENT_ID=
